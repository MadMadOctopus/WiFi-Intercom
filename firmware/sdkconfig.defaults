# Sensible defaults for the intercom firmware. Target: esp32c3.
# These are applied on a fresh `idf.py build`; delete sdkconfig to regenerate.

# --- Target ---
CONFIG_IDF_TARGET="esp32c3"

# --- Wi-Fi: disable power save for low latency (also forced in code) ---
CONFIG_ESP_WIFI_POWER_SAVE_NONE=y

# --- FreeRTOS tick at 1 kHz gives us clean 20 ms scheduling ---
CONFIG_FREERTOS_HZ=1000

# --- Main task stack a little larger; we spawn our own tasks anyway ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# --- OTA bootstrapping -----------------------------------------------------
# Two independently bootable 1.5 MiB application slots on the production
# 4 MiB XIAO. The first OTA-capable image must be flashed over USB; all later
# application updates are written to the inactive slot.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_ota.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Log level: info over USB serial ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Bump default UDP/LWIP buffers slightly for smoother audio ---
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
